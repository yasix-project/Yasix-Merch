{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "buildCommand": "npx prisma generate"
  },
  "deploy": {
    "preDeployCommand": "npx prisma migrate deploy",
    "startCommand": "node index.js",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
